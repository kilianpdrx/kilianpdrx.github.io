---
import EntryLogo from './EntryLogo.astro';
import { bio } from '../lib/bio';
import { dateRange } from '../lib/format';
---
<div class="entries">
  {bio.education.map((school) => (
    <article class="entry">
      <EntryLogo logo={school.logo} name={school.institution} />
      <div>
        <div class="entry__head">
          <h3 class="entry__org"><a href={school.website} target="_blank" rel="noopener">{school.institution}</a></h3>
          <span class="entry__date">{dateRange(school.startDate, school.endDate)}</span>
        </div>
        <p class="entry__location">{school.location}</p>
        <p class="entry__position">{school.studyType}, {school.area}</p>
        <details class="courses">
          <summary>Key courses ({school.courses.length})</summary>
          <ul>{school.courses.map((course) => <li>{course}</li>)}</ul>
        </details>
      </div>
    </article>
  ))}
</div>
